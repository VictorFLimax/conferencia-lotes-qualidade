# Configuração padrão embarcada no ZIP do BotCity.
# Usada quando não existe um .env na máquina do Runner.
# NÃO coloque segredos aqui: no Runner a autenticação vem do Maestro.
# Para sobrepor qualquer valor, crie parâmetros na task do Orchestrator.

MAESTRO_ENABLED=true
VAULT_ENABLED=false
CREDENTIAL_LABEL=credencial_erp

DATA_POOL_NAME=FilaConferenciaLotes_Eq_AGMV
INPUT_FILE=dados_entrada/inspecao_lotes_dia.xlsx
LOG_FILE=logs/execucao.log
RUN_DISPATCHER=false

# Automação web: playwright | selenium
WEB_AUTOMATION_ENABLED=true
WEB_AUTOMATION_DRIVER=playwright
WEB_AUTOMATION_URL=html/login.html
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_AUTO_INSTALL=true
SELENIUM_HEADLESS=true
WEB_USUARIO=usuario.teste
WEB_SENHA=senha.teste

SCREENSHOT_ENABLED=true
UPLOAD_ARTIFACTS=true

# Execution Log no Orchestrator (menu Execution Log)
# https://documentation.botcity.dev/maestro/maestro-sdk/log/
EXECUTION_LOG_LABEL=ConferenciaLotes_Execucao

LOG_LEVEL=INFO
