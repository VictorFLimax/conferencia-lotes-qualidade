MAESTRO_ENABLED=true
MAESTRO_SERVER_URL=https://lgcmd.botcity.dev
MAESTRO_LOGIN=
MAESTRO_API_KEY=SEU_API_KEY_AQUI

DATA_POOL_NAME=FilaConferenciaLotes_Eq_AGMV
INPUT_FILE=dados_entrada/inspecao_lotes_dia.xlsx
LOG_FILE=logs/execucao.log

# Vault (opcional)
VAULT_ENABLED=false
CREDENTIAL_LABEL=credencial_erp

# Popular a fila ao iniciar o bot (true/false)
RUN_DISPATCHER=false

# Automação web — escolha o driver: playwright | selenium
WEB_AUTOMATION_ENABLED=false
WEB_AUTOMATION_DRIVER=playwright
WEB_AUTOMATION_URL=
PLAYWRIGHT_HEADLESS=false
SELENIUM_HEADLESS=false
WEB_USUARIO=usuario.teste
WEB_SENHA=senha.teste

# Screenshots → Result Files no Maestro
# https://documentation.botcity.dev/maestro/maestro-sdk/result-files/
SCREENSHOT_ENABLED=true
UPLOAD_ARTIFACTS=true

LOG_LEVEL=INFO
